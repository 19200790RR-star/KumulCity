{
  "expo": {
    "name": "KumulCity",
    "slug": "KumulCity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kumulcity-logo.png",
    "scheme": "kumulcity",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/kumulcity-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F7F2",
        "foregroundImage": "./assets/images/kumulcity-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kumulcity-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F7F2",
          "image": "./assets/images/kumulcity-logo.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
